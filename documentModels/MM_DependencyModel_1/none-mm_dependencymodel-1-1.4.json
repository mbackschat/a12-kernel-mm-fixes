        "id": "ABS_ENTITY_FULLNAME_1",
        "name": "ABS_ENTITY_FULLNAME_1",
        "fieldType": {
          "type": "StringType",
          "StringType": {
            "errorMessage": [
              {
                "locale": "de_DE",
                "text": "$field.value$: Kontext- bzw. Vordrucknamen dürfen nur aus Buchstaben, Ziffern oder Unterstrichen bestehen. Kontextnamen müssen mit einem Buchstaben beginnen. Namensteile dürfen nicht länger als 60 Zeichen sein und werden mit Slashes voneinander getrennt. Feldnamen dürfen nur aus Buchstaben, Ziffern, Unterstrichen, Doppelpunkten oder Punkten bestehen. Sie dürfen nicht mit einem Punkt enden."
              },
              {
                "locale": "en_US",
                "text": "$field.value$: A group or root group name may only contain letters, numbers or underscores. Group names must begin with a letter. Name parts may not be longer than 60 characters and are separated by slashes. Field names may only contain letters, numbers, underscores, periods or colons. They may not end with a period."
              }
            ],
            "minLength": 1,
            "maxLength": 712,
            "pattern": "/[a-zA-Z0-9_üöäÜÖÄß]{1,60}(/[a-zA-Z][a-zA-Z0-9_üöäÜÖÄß]{0,59})*(/[a-zA-Z0-9_:]+([.][a-zA-Z][a-zA-Z0-9_:]*)*)?"
          }
        },
        "revision": "1"
      },
      {
        "id": "ABS_FIELD_NAME_ML_3",
        "name": "ABS_FIELD_NAME_ML_3",
        "fieldType": {
          "type": "StringType",
