                "locale": "de_DE",
                "text": "Kein korrekter Feldname."
              },
              {
                "locale": "en_US",
                "text": "Not a correct field name."
              }
            ],
            "maxLength": 713,
            "pattern": "/[a-zA-Z0-9_üöäÜÖÄß][/a-zA-Z0-9_üöäÜÖÄß]*/[a-zA-Z0-9_:]+([.][a-zA-Z][a-zA-Z0-9_:]*)*"
          }
        },
