                          {
                            "type": "Rule",
                            "id": "399eb9a5c125522db130191cc3e808bc",
                            "name": "ERROR_MESSAGE_MISSING_CODEGEN",
                            "internalDescription": [
                              {
                                "locale": "de_DE",
                                "text": "only for codegen\nIn case of code generation you have to specify an error message for each language.\nPlease note: the code-generator already ensures the condition of this rule, because the code-generator only fills in a language, if an error message is specified. However, we wanted to specify this rule in order to document the constraint.\n\n####"
                              }
                            ],
                            "Rule": {
                              "errorEntityRelPath": "../language",
                              "errorCode": "ERROR_MESSAGE_MISSING",
                              "errorCondition": "FieldFilled(language)\nAnd FieldNotFilled(errorMessage)",
                              "severity": "ERROR",
                              "errorMessage": [
                                {
                                  "locale": "en_US",
                                  "text": "Error message for language '$language.value$' is missing."
                                },
                                {
                                  "locale": "de_DE",
