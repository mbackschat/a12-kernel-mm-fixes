      {
        "id": "ABS_GROUP_PATH_ML_9",
        "name": "ABS_GROUP_PATH_ML_9",
        "fieldType": {
          "type": "StringType",
          "StringType": {
            "errorMessage": [
              {
                "locale": "de_DE",
                "text": "$field.value$: Kontext- bzw. Vordrucknamen dürfen nur aus Buchstaben, Ziffern oder Unterstrichen bestehen. Kontextnamen müssen mit einem Buchstaben beginnen. Namensteile dürfen nicht länger als 60 Zeichen sein und werden mit Slashes voneinander getrennt. Ein absoluter Kontextname muss mit einem Slash beginnen."
              },
              {
                "locale": "en_US",
                "text": "$field.value$: A group name may only contain letters, numbers or underscores. Group names must begin with a letter or an underscore. Name parts may not be longer than 60 characters and are separated by slashes. An absolute group name must begin with a slash."
              }
            ],
            "maxLength": 613,
            "pattern": "/[a-zA-Z0-9_üöäÜÖÄß]{1,60}(/[a-zA-Z_][a-zA-Z0-9_üöäÜÖÄß]{0,59})*"
          }
