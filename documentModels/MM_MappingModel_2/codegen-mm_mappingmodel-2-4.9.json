                      "name": "dmId",
                      "internalDescription": [
                        {
                          "locale": "de_DE",
                          "text": "The DM Id of the partial DM fragment that forms the preprocessing-computation DM when added to the virtual base model.\n\npreprocessing-computation-dm = (inputs + target) + preprocessingFragment\n\n(if no dmFragmentId is given, no fragment will be added, i.e. the set of precomputations will be empty)\n\n####"
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "TypeDefType",
                          "TypeDefType": {
