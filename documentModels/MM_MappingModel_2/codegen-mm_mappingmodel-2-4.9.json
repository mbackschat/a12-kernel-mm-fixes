                                  "Rule": {
                                    "errorEntityRelPath": "../sortFieldFullName",
                                    "errorCode": "SORT_INFO_MISSING",
                                    "errorCondition": "FieldsNotCollectivelyFilled(sortFieldFullName, sortType)",
                                    "severity": "ERROR",
                                    "errorMessage": [
