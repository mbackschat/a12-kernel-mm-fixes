                              }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "8b89692cea1897c617d2a8c914b90f94",
                      "name": "SOURCE_NAME_DUPLICATE",
                      "Rule": {
                        "errorEntityRelPath": "../name",
                        "errorCode": "SOURCE_NAME_DUPLICATE",
