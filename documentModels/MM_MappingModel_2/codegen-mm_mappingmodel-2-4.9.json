                  "repeatability": 1,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "672e742c963eb9485955387b4d9c38dc",
                      "name": "id",
                      "internalDescription": [
                        {
                          "locale": "de_DE",
                          "text": "The id of the structural mapping model that is part of this mapping model\nUsage of type definition REFERENCE needed in A12-SME.\n\n####"
                        }
                      ],
