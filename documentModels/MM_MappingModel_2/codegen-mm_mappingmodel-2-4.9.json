            "elements": [
              {
                "type": "Field",
                "id": "3522f33a76b8fbb261eaa216dbd74923",
                "name": "mappingType",
                "internalDescription": [
                  {
                    "locale": "de_DE",
                    "text": "Can be used by project specifics to tag mapping models and e.g. treat them specifically in project code. Does not directly influence the general A12 mapping behavior itself.\n\n####"
                  }
                ],
                "Field": {
                  "fieldType": {
                    "type": "TypeDefType",
                    "TypeDefType": {
                      "typeDefinitionId": "MAPPING_KEY_2"
                    }
                  }
                }
              },
              {
                "type": "Group",
                "id": "b2271ebb30e3063c556e45ea033237c",
                "name": "Source",
                "Group": {
                  "repeatability": 999,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "ce22f24b5efc8cdbc179e6176918990a",
                      "name": "name",
                      "internalDescription": [
                        {
                          "locale": "de_DE",
                          "text": "A name or id that uniquely identifies this source.\n\nAt modeling time, in the partially-generated precomputation dm, the source name will determine the root group name inside which the source dm is included.\n\nAt runtime, the calling code is expected to label the given source documents/IData with the corresponding name, in order to associate it with the appropriate source (in case there is more than one source).\n\nMay or may not be equal to the source's dmId, but it is recommended to not include the specific version of the source DM into the source name, so that both precomputation fragments and the calling code at runtime remain compatible across versions.\n\n####"
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "StringType",
                          "StringType": {
                            "errorMessage": [
                              {
                                "locale": "de_DE",
                                "text": "$field.value$: Ungültiger Name für die Quelle. Der Name darf nur Buchstaben ohne Umlaut, Ziffern und Unterstrich enthalten und muss mit einem Buchstaben beginnen."
                              },
                              {
                                "locale": "en_US",
                                "text": "$field.value$: Invalid source name. The name may only contain letters, digits and underscore and must begin with a letter."
                              }
                            ],
                            "maxLength": 50,
                            "pattern": "[a-zA-Z][a-zA-Z0-9_]*"
                          }
                        },
                        "requirednessConfig": {
                          "mode": "relativeToParent"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "44106cf002876bf032edea326f76e493",
                      "name": "dmId",
                      "internalDescription": [
                        {
                          "locale": "de_DE",
                          "text": "The dmId of the DM or DVL that validates if the input is valid to be included in the data mapping.\n\n####"
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "TypeDefType",
                          "TypeDefType": {
                            "typeDefinitionId": "REFERENCE_1"
                          }
                        },
                        "requirednessConfig": {
                          "mode": "relativeToParent"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "8852816af2540c53eb846c99febcd386",
                      "name": "maxRepeat",
                      "internalDescription": [
                        {
                          "locale": "de_DE",
                          "text": "The max. repeatability of the source model in the joined mapping model. Max. repeatability of 500 for a source document model means that up to 500 documents of that document model can be used for mapping.\n\n####"
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "NumberType",
                          "NumberType": {
                            "zeroNotAllowed": true,
                            "positivesOnly": true,
                            "minValue": 1
                          }
                        },
                        "requirednessConfig": {
                          "mode": "relativeToParent",
                          "errorMessage": [
                            {
                              "locale": "de_DE",
                              "text": "Die Wiederholbarkeit der Quelle muss angegeben werden."
                            },
                            {
                              "locale": "en_US",
                              "text": "The repeatability of the source must be specified."
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "396f06103ee7d7ab61130375d9c5de70",
                      "name": "includeLevel",
                      "internalDescription": [
                        {
                          "locale": "de_DE",
                          "text": "Default if not present: SINGLE_RG\n\n####"
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "EnumerationType",
                          "EnumerationType": {
                            "values": [
                              {
                                "value": "SINGLE_RG"
                              },
                              {
                                "value": "MODEL_ROOT"
                              }
                            ]
