                                      {
                                        "locale": "de_DE",
                                        "text": "Um ein Feld als Sortierfeld zu markieren, müssen jeweils Feldname und Sortierart gemeinsam spezifiziert werden."
                                      }
                                    ],
                                    "guiPatterns": {
                                      "dynamicEnumeration": "false"
                                    }
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "type": "Rule",
                            "id": "9ce2044bd7ce018e25d23badd0eadb5a",
                            "name": "SORT_FIELD_DUPLICATE",
                            "Rule": {
                              "errorEntityRelPath": "../SortFields/sortFieldFullName",
                              "errorCode": "SORT_FIELD_DUPLICATE",
