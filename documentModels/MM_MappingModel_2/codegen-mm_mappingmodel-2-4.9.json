                          {
                            "locale": "de_DE",
                            "text": "Der Name der Quelle muss eindeutig sein."
                          }
                        ],
                        "guiPatterns": {
                          "dynamicEnumeration": "false"
                        }
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "faa463ed0311262fd434bd40a53e3cce",
                      "name": "ER_MIGRATION_A_SOURCE_NAME_INVALID",
                      "Rule": {
                        "errorEntityRelPath": "../name",
                        "errorCode": "MIGRATION_A_SOURCE_NAME_INVALID",
                        "errorCondition": "FieldFilled(name)\nAnd [../mappingType] == \"migration_A\"\nAnd [name] != \"Vorjahr\"",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en_US",
                            "text": "For mapping type 'migration_A' only the source name \"Vorjahr\" is allowed."
                          },
                          {
                            "locale": "de_DE",
                            "text": "Beim Mappingtyp 'migration_A' muss als Quellname \"Vorjahr\" verwendet werden."
